# ============================================
# Root-level repo ignores (covers api/ + app/)
# ============================================

# Encrypted / personal binary blobs — never commit
*.enc
*.gpg
*.p12
*.pfx
*.key
*.pem
*.cer
*.crt
*.csr
id_rsa
id_ed25519
*_rsa
*_ed25519

# Secrets / env
.env
.env.*
!.env.example
*.env.local
auth.json
.npmrc
.htpasswd

# Local backups / dumps
*.sql
*.sqlite
*.sqlite-journal
*.dump
*.bak
*.backup
backup/
backups/

# IDE / OS noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Build / dependency artifacts (api/ and app/ have their own too)
node_modules/
vendor/
/public/storage
/public/hot
/storage/*.key
.phpunit.result.cache
.phpunit.cache/
coverage/

# Laravel storage — never commit user uploads, sessions, compiled views, logs
/api/storage/app/public/*
!/api/storage/app/public/.gitkeep
/api/storage/framework/cache/data/*
/api/storage/framework/sessions/*
/api/storage/framework/views/*
/api/storage/framework/testing/*
/api/storage/logs/*
!/api/storage/**/.gitkeep
/api/bootstrap/cache/*.php
!/api/bootstrap/cache/.gitignore

# Frontend build outputs
/app/dist/
/app/dist-ssr/
/app/.vite/

# Symlinks created by `php artisan storage:link`
/api/public/storage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc local
.history/
.tmp/
tmp/
