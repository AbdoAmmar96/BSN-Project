APP_NAME="BSN API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# Database
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bsn
DB_USERNAME=bsn
DB_PASSWORD=

# ============================================
# Cache / Session / Queue
# ============================================
BROADCAST_CONNECTION=reverb
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ============================================
# Sanctum SPA — Bearer tokens only.
# Leave SANCTUM_STATEFUL_DOMAINS empty so the SPA never hits CSRF/session flow.
# ============================================
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=.localhost
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.bp-eg.com

# ============================================
# Mail — set MAIL_MAILER=log in dev to dump emails to storage/logs/laravel.log,
# or MAIL_MAILER=smtp + real SMTP credentials in staging/production.
# ============================================
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@bp-eg.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# Laravel Reverb (WebSockets for chat)
# ============================================
REVERB_APP_ID=bsn-app
REVERB_APP_KEY=bsn-key
REVERB_APP_SECRET=bsn-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite-bound Reverb config (sent to the frontend via vite.config.js)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================
# PAYMENT GATEWAYS — leave empty in development.
# Fill with real credentials from each provider's dashboard before going live.
# See README → "Payment Gateways" section for sign-up links + onboarding times.
# ============================================

# Paymob (Cards + Wallets + Installments via Souhoola/ValU)
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_INSTALLMENTS=
PAYMOB_IFRAME_CARD=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Fawry
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_BASE_URL_LIVE=https://www.atfawry.com

# Kashier
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET=
KASHIER_MODE=test
KASHIER_BASE_URL=https://test-api.kashier.io

# ============================================
# Error tracking (Sentry) — optional. Leave empty to disable.
# Install: composer require sentry/sentry-laravel
# ============================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# App-specific
# ============================================
INVOICE_PREFIX=BSN
DEFAULT_CURRENCY=EGP
