VITE_API_URL=http://localhost:8000
VITE_APP_NAME="شريك الأعمال — BSN"

# Reverb (WebSockets for chat)
VITE_REVERB_APP_KEY=bsn-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Sentry (optional) — leave empty in dev. To enable:
#   npm i @sentry/react
#   Set VITE_SENTRY_DSN to your project DSN
VITE_SENTRY_DSN=

# Release identifier sent to Sentry / shown in build banners. CI should set
# this from git: VITE_APP_VERSION="bsn@$(git rev-parse --short HEAD)"
VITE_APP_VERSION=bsn@local
